  "satudata_search_datasets": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Cari dataset statistik resmi Kota Bogor di portal Satu Data (opendata.kotabogor.go.id). Angka statistik sektoral resmi Kota Bogor diambil lewat tool ini, bukan dari ingatanmu. Panggil tool ini lebih dulu setiap kali pertanyaan membutuhkan angka statistik Kota Bogor.\n\nIsi `query` dengan kata kunci topik dalam bahasa Indonesia (mis. \"kemiskinan\", \"PAD\", \"kunjungan wisatawan\"), bukan kalimat pertanyaan. `opd`, `topik`, dan `tahun` opsional untuk mempersempit.\n\nHasilnya daftar dataset (slug, nama, OPD, satuan, rentang tahun, waktu pembaruan, status resmi/draf), tanpa angka data. Pilih satu slug lalu panggil satudata_get_dataset_info.\n\nGalat NO_MATCH berarti kata kunci itu tidak cocok dengan dataset mana pun; coba sekali lagi dengan kata yang lebih umum atau sinonim; bila tetap kosong, katakan data tidak tersedia di portal dan jangan memakai dataset lain yang mengukur hal berbeda. Dataset dengan nama mirip belum tentu indikator yang sama.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "opd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slug atau nama OPD (opsional).",
          "title": "Opd"
        },
        "page": {
          "default": 1,
          "description": "Halaman hasil, mulai 1.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 10,
          "description": "Jumlah dataset per halaman.",
          "maximum": 20,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "query": {
          "description": "Kata kunci topik dalam bahasa Indonesia, mis. \"kemiskinan\" atau \"PAD\".",
          "maxLength": 100,
          "minLength": 2,
          "title": "Query",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Diisi oleh sistem pemanggil; biarkan kosong.",
          "title": "Request Id"
        },
        "tahun": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 2000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hanya dataset yang rentang tahunnya mencakup tahun ini.",
          "title": "Tahun"
        },
        "topik": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nama topik portal (opsional).",
          "title": "Topik"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchParams",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ErrorCode": {
          "enum": [
            "INVALID_PARAM",
            "DATASET_NOT_FOUND",
            "NO_MATCH",
