# Salin ke .env lalu sesuaikan. .env tidak boleh di-commit.

# --- Sumber data (AK-01..06) ---
MCP_SOURCE_BASE_URL=https://opendata.kotabogor.go.id/api
MCP_USER_AGENT=mcp-bogor/0.1 (+<kontak-tim>)
MCP_REQUEST_DELAY_S=0.2
MCP_HTTP_TIMEOUT_S=20
MCP_MAX_RETRIES=5
# Tunggu 429/5xx lebih lama dari ini (detik) -> langsung gagal tanpa tidur (KB-24)
MCP_BACKOFF_MAX_S=30

# --- Penyimpanan (path relatif di-resolve terhadap direktori kerja) ---
MCP_DB_PATH=./var/mcp_bogor.db
MCP_CACHE_DIR=./var/cache
# Kurasi kamus kolom per slug, overrides/<slug>.yaml (KK-07)
MCP_OVERRIDES_DIR=./overrides
MCP_CACHE_TTL_H=24
# Cache usang boleh disajikan (STALE_DATA) saat portal gagal, maksimal umur ini (jam; KB-32)
MCP_CACHE_STALE_MAX_H=168
# Batas total ukuran cache data (MB) dan baris per cache (KB-32)
MCP_CACHE_MAX_MB=500
MCP_CACHE_MAX_ROWS=50000
# Baris sampel /bigdata untuk menentukan peran kolom kamus (KB-36)
MCP_DICTIONARY_SAMPLE_ROWS=100
# Seri ≤ ini diambil tanpa filter lalu disaring lokal; di atasnya filter ke portal (KB-37)
MCP_SERIES_LOCAL_MAX_ROWS=5000
MCP_CATALOG_SYNC_MIN_INTERVAL_H=24
# Sinkron failed/incomplete (bukan karena 429) boleh diulang setelah (jam; KB-28)
MCP_CATALOG_SYNC_RETRY_AFTER_H=6
# Jeda antarpermintaan sync_worker (detik, minimal 0.2; KB-26)
MCP_SYNC_REQUEST_DELAY_S=0.5

# --- Transport ---
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8800
# Host tambahan yang diizinkan (proteksi DNS rebinding), dipisah koma; 127.0.0.1:<port>
# dan localhost:<port> selalu diizinkan (KB-47)
MCP_HTTP_ALLOWED_HOSTS=
# Origin yang diizinkan, dipisah koma; kosong = permintaan ber-Origin ditolak (KB-47)
MCP_HTTP_ALLOWED_ORIGINS=
# Token bearer opsional untuk /mcp; bila diisi, wajib di header Authorization (KB-47)
MCP_HTTP_AUTH_TOKEN=
MCP_FILESERVER_HOST=127.0.0.1
MCP_FILESERVER_PORT=8799
MCP_FILESERVER_PUBLIC_URL=http://localhost:8799

# --- data_ref (ADR-008); buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_DATAREF_SECRET=ganti-dengan-rahasia-acak
# Secret lama saat rotasi: hanya untuk verifikasi tautan lama, kosongkan setelah 1x TTL (KB-33)
MCP_DATAREF_SECRET_PREVIOUS=
MCP_DATAREF_TTL_SECONDS=900

# --- Kontrak dan batas (Dok 4 bagian 9) ---
MCP_TOOL_PREFIX=satudata_
# Iklankan outputSchema amplop di list_tools (KB-42 revisi); false bila klien MCP
# Citya meneruskannya ke konteks model dan memboroskan token
MCP_EXPOSE_OUTPUT_SCHEMA=true
MCP_MAX_RESPONSE_TOKENS=2000
MCP_SEARCH_MAX_PAGE_SIZE=20
MCP_TOP_VALUES=10
MCP_PREVIEW_ROWS=5
MCP_DESCRIPTION_MAX_CHARS=600
MCP_INLINE_ROWS_FALLBACK=false
MCP_FORCE_REFRESH_MIN_INTERVAL_S=300

# --- Mutu data (Dok 2 QC-02, KB-18): ambang rasio antarkelompok periode ---
MCP_QC_RATIO=50

# --- Log ---
MCP_LOG_LEVEL=INFO
