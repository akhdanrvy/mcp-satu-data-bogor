# Salin ke .env lalu sesuaikan. .env tidak boleh di-commit.

# --- Sumber data (AK-01..06) ---
MCP_SOURCE_BASE_URL=https://opendata.kotabogor.go.id/api
MCP_USER_AGENT=mcp-bogor/0.1 (+<kontak-tim>)
MCP_REQUEST_DELAY_S=0.2
MCP_HTTP_TIMEOUT_S=20
MCP_MAX_RETRIES=5
# Tunggu 429/5xx lebih lama dari ini (detik) -> langsung gagal tanpa tidur (KB-24)
MCP_BACKOFF_MAX_S=30

# --- Penyimpanan (path relatif di-resolve terhadap direktori kerja) ---
MCP_DB_PATH=./var/mcp_bogor.db
MCP_CACHE_DIR=./var/cache
MCP_CACHE_TTL_H=24
MCP_CATALOG_SYNC_MIN_INTERVAL_H=24

# --- Transport ---
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8800
MCP_FILESERVER_HOST=127.0.0.1
MCP_FILESERVER_PORT=8799
MCP_FILESERVER_PUBLIC_URL=http://localhost:8799

# --- data_ref (ADR-008); buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_DATAREF_SECRET=ganti-dengan-rahasia-acak
MCP_DATAREF_TTL_SECONDS=900

# --- Kontrak dan batas (Dok 4 bagian 9) ---
MCP_TOOL_PREFIX=satudata_
MCP_MAX_RESPONSE_TOKENS=2000
MCP_SEARCH_MAX_PAGE_SIZE=20
MCP_TOP_VALUES=10
MCP_PREVIEW_ROWS=5
MCP_DESCRIPTION_MAX_CHARS=600
MCP_INLINE_ROWS_FALLBACK=false
MCP_FORCE_REFRESH_MIN_INTERVAL_S=300

# --- Mutu data (Dok 2 QC-02, KB-18): ambang rasio antarkelompok periode ---
MCP_QC_RATIO=50

# --- Log ---
MCP_LOG_LEVEL=INFO
